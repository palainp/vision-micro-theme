# vision-blue: blue text-mode colorscheme for micro
#
# Sources (attribute bytes are background nibble + foreground nibble, CGA palette):
# - Editor: Free Pascal IDE, packages/ide/fpconst.pas (CSourceWindow 33-48)
#   mapped through packages/ide/weditor.pas (CEditor, ColorTab).
# - Menu bar, status line, window frame: Borland Turbo Vision 2.0 cpAppColor
#   (entries 2-7 menu/status line, 8-15 blue window), as kept in magiblot/tvision.
# Groups with no equivalent in the IDE are marked "no TP equivalent".
#
# CGA index -> micro colour name (CGA and ANSI orders differ):
# 0 black   1 blue   2 green   3 cyan   4 red   5 magenta   6 yellow (brown)
# 7 white   8 brightblack   9 brightblue   A brightgreen   B brightcyan
# C brightred   D brightmagenta   E brightyellow   F brightwhite
# color-column uses black: no CGA colour between blue and black.

# --- Syntax ---
color-link default "brightyellow,blue"
# $1E text, identifier, symbol
color-link identifier "brightyellow,blue"
color-link type "brightyellow,blue"
color-link symbol "brightyellow,blue"
color-link constant "brightyellow,blue"
# $1F reserved word
color-link statement "brightwhite,blue"
# $17 comment
color-link comment "white,blue"
# $1B string
color-link constant.string "brightcyan,blue"
color-link constant.specialChar "brightcyan,blue"
# $13 number and hex number
color-link constant.number "cyan,blue"
# $1C directive
color-link preproc "brightred,blue"
# $1A assembler
color-link special "brightgreen,blue"
# $4E error / breakpoint
color-link error "brightyellow,red"
# no TP equivalent
color-link todo "brightwhite,blue"
color-link underlined "underline brightyellow,blue"

# --- Editor area ---
# $71 selected block
color-link selection "blue,white"
# no current-line highlight in the IDE: same as background
color-link cursor-line "blue"
# $19 whitespace / tab
color-link indent-char "brightblue,blue"
# $30 highlighted row
color-link hlsearch "black,cyan"
# $3F highlighted column
color-link match-brace "brightwhite,cyan"
# $4E error
color-link tab-error "brightyellow,red"
color-link trailingws "brightyellow,red"
color-link gutter-error "brightyellow,red"
# no TP equivalent (the IDE had no line numbers, gutter or diff)
color-link line-number "white,blue"
color-link current-line-number "brightwhite,blue"
color-link color-column "black"
color-link gutter-warning "black,yellow"
color-link diff-added "brightgreen,blue"
color-link diff-modified "brightyellow,blue"
color-link diff-deleted "brightred,blue"

# --- Chrome ---
# $70 menu / status line normal text
color-link statusline "black,white"
color-link tabbar "black,white"
color-link message "black,white"
# $78 menu / status line disabled text
color-link statusline.inactive "brightblack,white"
# $20 menu / status line selection
color-link statusline.suggestions "black,green"
color-link tabbar.active "black,green"
# $1F active window frame
color-link divider "brightwhite,blue"
# $31 scroll bar
color-link scrollbar "blue,cyan"
# $4E error
color-link error-message "brightyellow,red"
